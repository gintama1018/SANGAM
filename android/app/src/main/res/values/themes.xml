<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.FrameRoom" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/surface_onyx</item>
        <item name="android:navigationBarColor">@color/surface_onyx</item>
        <item name="android:windowBackground">@color/surface_onyx</item>
    </style>

    <!-- Native Splash Screen Theme (androidx.core:core-splashscreen) -->
    <style name="Theme.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_onyx</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_shutter_click</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.FrameRoom</item>
    </style>
</resources>
