<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="sequentially">
    <!-- Phase 1: Aperture blades rotate shut towards f/16 (0 to 340ms) -->
    <objectAnimator
        android:duration="340"
        android:propertyName="rotation"
        android:valueFrom="0.0"
        android:valueTo="55.0"
        android:valueType="floatType"
        android:interpolator="@android:interpolator/accelerate_cubic" />
    <!-- Phase 2: Shutter blades snap back open to resting position with overshoot spring (340 to 800ms) -->
    <objectAnimator
        android:duration="460"
        android:propertyName="rotation"
        android:valueFrom="55.0"
        android:valueTo="0.0"
        android:valueType="floatType"
        android:interpolator="@android:interpolator/overshoot" />
</set>
